go.property("level", 1)
LEVEL_DIGIT_FRAMES = {hash("0"), hash("1"), hash("2"), hash("3"),
hash("4"), hash("5"), hash("6"), hash("7"), hash("8"), hash("9")}

local function setup(self)
	sprite.play_flipbook("#digit1", LEVEL_DIGIT_FRAMES[math.floor(self.level / 10) % 10 + 1])
	sprite.play_flipbook("#digit2", LEVEL_DIGIT_FRAMES[self.level % 10 + 1])
	self.timer = 1.6
	self.state = 1
	msg.post(".", "enable")
	sound.play("/sounds#levelup")
end

function init(self)
	self.level = 1
	self.timer = 0
	self.state = 0
end

function update(self, dt)
	if self.state == 1 then
		self.timer = self.timer - dt
		if self.timer <= 0 then
			self.state = 0
			msg.post("/game_area#game_area", "setup", {level = self.level})
			msg.post(".", "disable")
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("setup") then
		self.level = message.level
		setup(self)
	end
end

