MAX_TILT = 40.0
MIN_TILT = -40.0
TILT_SPEED = 25.0
NECK_SPEED = 50.0
NECK_MAX = 285.0
NECK_MIN = 93.0
STRETCH_SPEED = 0.5

function init(self)
	self.tilt = 0
	self.tilt_dir = 0
	self.neck_dir = 1
	self.neck_speed = NECK_SPEED
	self.pos = go.get_position()
	self.state = 1
	self.space_pressed = false
	self.cheek_stretch = 0.2
	self.wait = 0
	self.vertical_dir = 0
	msg.post("/cheek","disable")
	msg.post("/launch_bull","disable")
	msg.post(".", "acquire_input_focus")
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	self.wait = self.wait - dt
	if self.tilt_dir == 1 then
		self.tilt = self.tilt + dt * TILT_SPEED
		if self.tilt >= MAX_TILT then
			self.tilt = MAX_TILT
		end
	elseif self.tilt_dir == 2 then
		self.tilt = self.tilt - dt * TILT_SPEED
		if self.tilt <= MIN_TILT then
			self.tilt = MIN_TILT
		end
	end
	--if self.neck_dir == 1 then
	--	self.pos.y = self.pos.y + dt * NECK_SPEED
	--	if self.pos.y >= NECK_MAX then
	--		self.pos.y = NECK_MAX
	--		self.neck_dir = 2
	--	end
	--elseif self.neck_dir == 2 then
	--	self.pos.y = self.pos.y - dt * NECK_SPEED
	--	if self.pos.y <= NECK_MIN then
	--		self.pos.y = NECK_MIN
	--		self.neck_dir = 1
	--	end
	--end
	if self.vertical_dir == 1 then
		self.pos.y = self.pos.y + dt * NECK_SPEED
		if self.pos.y >= NECK_MAX then
			self.pos.y = NECK_MAX
		end
	elseif self.vertical_dir == 2 then
		self.pos.y = self.pos.y - dt * NECK_SPEED
		if self.pos.y <= NECK_MIN then
			self.pos.y = NECK_MIN
		end
	end
	go.set_position(self.pos)
	self.tilt_dir = 0
	self.vertical_dir = 0
	go.set_rotation(vmath.quat_rotation_z(math.rad(self.tilt)),"/left_cranium")
	if self.state == 1 then  -- Normal
		if self.space_pressed then
			sprite.play_flipbook("/left_cranium#sprite", hash("head_left2"))
			self.cheek_stretch = 0.2
			go.set_scale(vmath.vector3(1.0-self.cheek_stretch, 1.0, 1.0), "/cheek")
			go.set_position(vmath.vector3(28.0-23.0*self.cheek_stretch, -24.0, 0), "/cheek")
			msg.post("/cheek","enable")
			go.set_position(vmath.vector3(66.0-46.0*self.cheek_stretch, -19.0, -0.1), "/launch_bull")
			msg.post("/launch_bull","enable")
			self.state = 2
		end
	elseif self.state == 2 then -- Stretching cheek
		if self.space_pressed and self.cheek_stretch < 1.0 then
			self.cheek_stretch = self.cheek_stretch + dt * STRETCH_SPEED
			self.cheek_stretch = math.min(self.cheek_stretch, 1.0)
			go.set_scale(vmath.vector3(1.01-self.cheek_stretch, 1.0, 1.0), "/cheek")
			go.set_position(vmath.vector3(28.0-23.0*self.cheek_stretch, -24.0, 0), "/cheek")
			go.set_position(vmath.vector3(66.0-46.0*self.cheek_stretch, -19.0, -0.1), "/launch_bull")				
		else
			msg.post("/launch_bull","disable")
			local bullpos = go.get_world_position("/launch_bull")
			local bullrot = go.get_world_rotation("/launch_bull")
			bullpos.z = 0.1
			local imp = vmath.vector3(300.0*self.cheek_stretch, 0, 0)
			local rot_imp = vmath.rotate(bullrot, imp)
			local id = factory.create("/game_area#bull_factory", bullpos, bullrot,
			{start_impulse = rot_imp})
			--msg.post(id, "set_parent", { parent_id = go.get_id("/bullpen") })
			msg.post("/game_area#game_area", "new_bull", {id = id})
			self.wait = 0.3
			self.state = 3
		end
	elseif self.state == 3 then -- Holding mouth open
		if self.wait <= 0 then
			msg.post("/cheek","disable")
			sprite.play_flipbook("/left_cranium#sprite", hash("head_left1"))
			self.wait = 0.3
			self.state = 4
		end
	elseif self.state == 4 then -- Reload time
		if self.wait <= 0 then
			self.state = 1
		end
	end
	self.space_pressed = false
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

