MAX_TILT = 40.0
MIN_TILT = -40.0
TILT_SPEED = 25.0
NECK_SPEED = 30.0
NECK_MAX = 285.0
NECK_MIN = 93.0

function init(self)
	self.tilt = 0
	self.tilt_dir = 0
	self.neck_dir = 1
	self.neck_speed = NECK_SPEED
	self.pos = go.get_position()
	msg.post(".", "acquire_input_focus")
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	if self.tilt_dir == 1 then
		self.tilt = self.tilt + dt * TILT_SPEED
		if self.tilt >= MAX_TILT then
			self.tilt = MAX_TILT
		end
	elseif self.tilt_dir == 2 then
		self.tilt = self.tilt - dt * TILT_SPEED
		if self.tilt <= MIN_TILT then
			self.tilt = MIN_TILT
		end
	end
	if self.neck_dir == 1 then
		self.pos.y = self.pos.y + dt * NECK_SPEED
		if self.pos.y >= NECK_MAX then
			self.pos.y = NECK_MAX
			self.neck_dir = 2
		end
	elseif self.neck_dir == 2 then
		self.pos.y = self.pos.y - dt * NECK_SPEED
		if self.pos.y <= NECK_MIN then
			self.pos.y = NECK_MIN
			self.neck_dir = 1
		end
	end
	go.set_position(self.pos)
	self.tilt_dir = 0
	go.set_rotation(vmath.quat_rotation_z(math.rad(self.tilt)),"/left_cranium")
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
end

function on_input(self, action_id, action)
	if action_id == hash("up") then
		self.tilt_dir = 1
	elseif action_id == hash("down") then
		self.tilt_dir = 2
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
