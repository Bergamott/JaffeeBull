local function setup(self)
	self.state = 1
	go.set_position(vmath.vector3(0, 0, 0.5))
	msg.post("/game_area","disable")
	msg.post("/center_line","disable")
	msg.post(".", "acquire_input_focus")
	msg.post(".", "enable")
end

function init(self)
	msg.post("/level_screen", "disable")
	self.state = 0
	self.timer = 0
	setup(self)
end

function update(self, dt)
	if self.state == 1 then
		self.timer = self.timer - dt
		if self.timer < 0 then
			local ang = 0.5 + math.random() * 0.3
			local bullrot = vmath.quat_rotation_z(ang)
			local bullpos = vmath.vector3(-20.0, 150.0, 0.55)
			local imp = vmath.vector3(250.0*(1.0 + math.random()), 0, 0)
			local rot_imp = vmath.rotate(bullrot, imp)
			local id = factory.create("/menu#menu_bull_factory", bullpos, bullrot,
			{start_impulse = rot_imp})
			self.timer = 1.0+2.0*math.random()
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("setup") then
		setup(self)
	end
end

function on_input(self, action_id, action)
	if action_id == hash("space") then
		msg.post("/level_screen#levels", "setup", {level = 1})
		msg.post(".", "release_input_focus")
		msg.post(".", "disable")
		self.state = 0
	end
end

