go.property("start_impulse", vmath.vector3(1,0,0))

function init(self)
	self.my_hex = hash_to_hex(go.get_id())
	local body = b2d.get_body("#collisionobject")
	local center = b2d.body.get_world_center(body)
	center.y = center.y + 3.0*(math.random() - 0.5)
	b2d.body.apply_linear_impulse(body, self.start_impulse, center)	
end

function update(self, dt)
	local pos = go.get_position()
	if pos.y < -80.0 then
		go.delete()
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") then
		local imp = message.applied_impulse
		if imp > 50.0 and self.my_hex < hash_to_hex(message.other_id) then
			if imp > 200.0 then
				sound.play("/sounds#bounce1")
			elseif imp > 100 then
				sound.play("/sounds#bounce2")
			else
				sound.play("/sounds#bounce3")
			end
		end
	end
end

